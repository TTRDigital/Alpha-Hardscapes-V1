# Copy to .env.local for local development. In Vercel: Project Settings > Environment Variables.
# Never commit real values. The site builds and runs with NONE of these set (built-in fallback content).

# --- Public site address (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://alphahardscapes.com

# --- Sanity (public, not secret). The ALPHA prefix stops a generic NEXT_PUBLIC_SANITY_PROJECT_ID
# set for another site from pointing this site at the wrong project.
NEXT_PUBLIC_ALPHA_SANITY_PROJECT_ID=
NEXT_PUBLIC_ALPHA_SANITY_DATASET=production
NEXT_PUBLIC_ALPHA_SANITY_API_VERSION=2026-11-01

# --- Sanity read access (optional). Leave empty for a public dataset. A Viewer token lets the
# site build from a private dataset. Server-only, never exposed to the browser.
SANITY_READ_TOKEN=

# --- Sanity write token: ONLY for `npm run seed` (an Editor token). Never needed by the site build.
# Add it in GitHub Actions secrets or run the seed locally; never put it in code, chat or commits.
SANITY_API_TOKEN=

# --- Publish -> rebuild. Same secret in Sanity (API > Webhooks) and here. Optional Vercel deploy hook URL
# that the webhook route calls after publishing so a full redeploy happens.
SANITY_REVALIDATE_SECRET=
VERCEL_DEPLOY_HOOK_URL=

# --- Lead delivery (at least one). GoHighLevel inbound webhook and/or email through Resend.
GHL_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_EMAIL_TO=alphahardscapes1@gmail.com
LEAD_EMAIL_FROM=
